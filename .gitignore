# ------------------------------------------------------------------------------
# 1. Базовый Python (кэш, байткод и компиляция)
# ------------------------------------------------------------------------------
# Кэш скомпилированного байткода Python
__pycache__/
# Скомпилированные файлы (.pyc, .pyo, .pyd)
*.py[cod]
# Байткод файлов классов Jython
*$py.class
# Скомпилированные расширения на C/C++
*.so
# Ссылка на интерпретатор
.Python
# Временные папки сборки пакетов
build/
# Временные пути разработки для EasyInstall
develop-eggs/
# Папки с дистрибутивами собранных пакетов
dist/
# Папки загрузок зависимостей
downloads/
# EasyInstall яйца пакетов
eggs/
.eggs/
# Временные библиотеки сборки
lib/
lib64/
# Части сборщика Buildout
parts/
# Архивы исходного кода дистрибутива
sdist/
# Временные переменные файлы приложений
var/
# Кэш сборки Wheel пакетов
wheels/
# Метаданные пакета сборщика
*.egg-info/
# Конфигурация Buildout
.installed.cfg
# Собраные EasyInstall пакеты
*.egg
# Файлы манифеста упаковщика
MANIFEST
# Системные манифесты сборки PyInstaller
*.manifest
# Спецификации сборки PyInstaller
*.spec

# ------------------------------------------------------------------------------
# 2. Виртуальные окружения (среды выполнения зависимостей)
# ------------------------------------------------------------------------------
# Стандартная папка виртуального окружения venv
venv/
# Скрытая папка виртуального окружения
.venv/
# Альтернативное название папки venv
env/
.env/
# Папка окружения в верхнем регистре
ENV/
# Бэкап папки виртуального окружения
env.bak/
venv.bak/
# Локальный файл самопроверки pip
pip-selfcheck.json
# Папка pip-env окружения
.pip-env/
# Папки окружения Node, если применимо
active_node/

# ------------------------------------------------------------------------------
# 3. Файлы окружения и секреты (чувствительные данные)
# ------------------------------------------------------------------------------
# Файл локальных переменных окружения (секреты)
.env
# Локальные переменные окружения веб-серверов
.env.local
# Любые резервные файлы конфигураций .env
.env.*
# Приватные TLS/SSL ключи авторизации
*.pem
# Приватные файлы криптографических ключей
*.key
# Папка с паролями, токенами доступа и API-ключами
secrets/
# Локальные доступы к API (например, Google Cloud)
credentials.json
# Файлы конфигураций с приватными настройками
config_private.py

# ------------------------------------------------------------------------------
# 4. Специфика Machine Learning / Data Science
# ------------------------------------------------------------------------------

# Папки с датасетами и сырыми данными
# Основная папка с данными/датасетами
data/
# Альтернативная папка для датасетов
dataset/
datasets/
# Исходные (необработанные) данные пациентов
raw_data/
# Обработанные/нормализованные промежуточные данные
processed_data/
# Временные файлы расчетов датасетов
temp_data/

# Форматы файлов данных (таблицы, архивы, тензоры)
# Табличные файлы CSV (база данных dataset_final.csv и т.д.)
*.csv
!saved_patients.csv
# Табличные файлы Excel (разметка и аннотации)
*.xlsx
*.xls
# JSON файлы конфигурации или разметки данных
*.json
# XML файлы аннотаций
*.xml
# Датасеты в формате HDF5 (большие объемы данных)
*.h5
*.hdf5
# Бинарные массивы NumPy (тензоры и эмбеддинги)
*.npy
# Сжатые архивы массивов NumPy
*.npz
# Сжатые столбчатые базы данных Apache Parquet
*.parquet
# Быстрые двоичные таблицы Feather
*.feather
# Сериализованные объекты Python (могут содержать данные)
*.pkl
*.pickle

# Медицинские форматы снимков и изображений (КТ, МРТ, Рентген)
# Медицинские снимки DICOM (снимки легких пациентов)
*.dcm
*.dicom
# Томографические 3D снимки NIfTI
*.nii
# Сжатые томографические снимки NIfTI
*.nii.gz
# Снимки легких в формате PNG (если лежат в папках с данными)
*.png
# Изображения легких в формате JPG
*.jpg
*.jpeg
# Высококачественные изображения TIFF
*.tiff
# Битмапы BMP
*.bmp

# Исключения для статических ресурсов фронтенда (чтобы стили и картинки UI не игнорировались)
!/static/
!/templates/
!/static/**/*.png
!/static/**/*.jpg
!/static/**/*.jpeg
!/static/**/*.svg
!/static/**/*.ico

# Веса, сохраненные модели и дампы градиентного бустинга
# Веса моделей PyTorch (нейросети прогнозирования)
*.pth
# Скомпилированные модели PyTorch (TorchScript)
*.pt
# Модели в универсальном формате ONNX
*.onnx
# Графы моделей TensorFlow (Protobuf)
*.pb
# Легковесные модели TensorFlow Lite
*.tflite
# Бинарные файлы моделей общего формата
*.model
# Сохраненные модели машинного обучения joblib
*.joblib
# Папка с логами обучения CatBoostClassifier
catboost_info/
# Специфический дамп модели CatBoost
catboost_model.pkl
# Сохраненная лучшая модель классификатора
best_model.pkl
# Сохраненная модель LightGBM
lightgbm_model.pkl
# Резервные копии сохраненных классификаторов
model.pkl
# Временные веса и логи нейросети TabNet
.tabnet/

